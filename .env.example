# Скопируйте в `.env` и заполните значения: `cp .env.example .env`
#
# Пустое значение (`VAR=`) допустимо только у необязательных переменных и означает
# «не задано». У переменной со значением по умолчанию пустая строка — ошибка старта:
# либо заполните её, либо удалите строку. Полный список и проверки — `server/src/config/env.ts`.
#
# Значения ниже — это пресет 1 (браузерный голос + локальная Ollama): скопируйте
# файл как есть, запустите Ollama, и приложение заработает. Два других пресета
# лежат следом в комментариях: замените ими блоки LLM/STT/TTS целиком.
# Чем отличаются провайдеры и чем платишь за каждый выбор — `docs/providers.md`.
# Проверить живой стек после настройки: `npm run smoke`.

# =============================================================================
# ПРЕСЕТ 1 — браузерный голос + Ollama (по умолчанию, ничего поднимать не нужно,
# кроме самой Ollama). Голос делает браузер: нужен Chromium-браузер (Chrome, Edge,
# Arc) — в Firefox распознавания речи нет, ему нужен серверный STT из пресета 2.
#
#   ollama serve            # или нативное приложение Ollama, или профиль ollama
#   ollama pull qwen3:8b
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=
# STT_PROVIDER=browser
# STT_BASE_URL=
# STT_MODEL=
# STT_API_KEY=
# TTS_PROVIDER=browser
# TTS_BASE_URL=
# TTS_MODEL=
# TTS_API_KEY=
# TTS_VOICE=
# TTS_FORMAT=mp3
# =============================================================================
# ПРЕСЕТ 2 — полностью локальный стек в Docker: распознавание и синтез делает
# сервер, браузер нужен любой. Голос тогда никуда не уходит с машины.
#
#   docker compose --profile ollama up -d   # LLM,           :11434
#   docker compose --profile stt up -d      # распознавание, :8000
#   docker compose --profile tts up -d      # синтез,        :8880
#   docker compose exec ollama ollama pull qwen3:8b
#   npm run stack:up                        # то же самое одной командой
#
# Kokoro (профиль tts) не умеет немецкий и русский: для них оставьте
# TTS_PROVIDER=browser, а серверным держите только распознавание.
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=
# STT_PROVIDER=openai
# STT_BASE_URL=http://localhost:8000/v1
# STT_MODEL=Systran/faster-whisper-small
# STT_API_KEY=
# TTS_PROVIDER=openai
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_MODEL=kokoro
# TTS_API_KEY=
# TTS_VOICE=af_sky
# TTS_FORMAT=mp3
# =============================================================================
# ПРЕСЕТ 3 — облачный OpenAI-совместимый ключ: ничего локально поднимать не надо,
# качество выше, но весь звук и все тексты уходят провайдеру, а занятия стоят
# денег. Имена моделей и голосов сверьте с актуальной документацией провайдера;
# для другого облака (OpenRouter, Groq, Together) меняется только *_BASE_URL.
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# STT_PROVIDER=openai
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1
# STT_API_KEY=sk-...
# TTS_PROVIDER=openai
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=tts-1
# TTS_API_KEY=sk-...
# TTS_VOICE=alloy
# TTS_FORMAT=mp3
# =============================================================================

# ---------- Приложение ----------
# development | test | production
NODE_ENV=development
# Порт HTTP API (Fastify)
PORT=8787
# Интерфейс, на котором слушает API. По умолчанию только петля.
# ВНИМАНИЕ: аутентификации в приложении нет по замыслу — профиль, загруженные
# материалы и расшифровки уроков доступны любому, кто дотянется до порта.
# Ставьте 0.0.0.0 только в доверенной сети и осознанно.
HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Порт dev-сервера Vite
WEB_PORT=5173
# Где пользователю искать настройки: env — файл `.env` рядом с приложением,
# desktop — меню установленного приложения. Значение попадает в подсказки
# интерфейса («поправьте настройки и перезапустите»), поэтому менять его руками
# незачем: desktop проставляет себе сама десктопная сборка.
CONFIG_SOURCE=env

# ---------- Хранилище ----------
# Файл базы SQLite. Пусто — `data/app.db` в корне репозитория.
# Относительный путь считается от рабочего каталога процесса.
DB_PATH=
# Каталог загруженных материалов; относительный путь — от корня репозитория
UPLOAD_DIR=./data/uploads
# Предел размера загружаемого файла и тела JSON-запроса, МиБ
# Предел размера одного загружаемого файла, МиБ.
# Файл целиком читается в память при извлечении текста, поэтому при больших
# значениях следите за расходом памяти: 200 МиБ PDF при разборе занимают
# заметно больше собственного размера.
MAX_UPLOAD_MB=200
# Предел ИЗВЛЕЧЁННОГО текста в символах — это не размер файла.
# Пусто — вывести из MAX_UPLOAD_MB (×1.1, потолок 250 000 000), чтобы два
# предела не противоречили друг другу. Задавайте явно, только если хотите
# принимать большие файлы, но ограничивать объём текста из них.
# На объём промпта не влияет: в модель уходит только отобранная под бюджет
# выборка фрагментов.
MAX_MATERIAL_TEXT_CHARS=

# ---------- Распознавание сканов (PDF без текстового слоя) ----------
# Что делать с PDF, в котором нет текста, — со сканом учебника:
#   off    — ничего: материал получает статус error_no_text_layer;
#   ocr    — растеризовать страницы и распознать локально (~0.3 с на страницу,
#            только текст, без картинок и вёрстки);
#   vision — отправить страницы картинками в зрячую модель: она возвращает текст
#            И словесные описания иллюстраций, понимает таблицы и колонки, но
#            стоит минуты на страницу.
# Обработка скана идёт В ФОНЕ: загрузка сразу отвечает статусом `processing`,
# а ход работы виден в материале («страница 12 из 48»).
# Нужна утилита pdftoppm из poppler: `brew install poppler` / `apt install poppler-utils`.
SCAN_MODE=ocr
# Разрешение растеризации страниц, 72..400. Ниже 150 распознавание заметно
# теряет мелкий шрифт, выше 300 — почти не улучшает результат, но замедляет работу.
SCAN_DPI=150
# Сколько первых страниц скана обрабатывается, 1..2000.
# Превышение — не ошибка: материал получит распознанные первые страницы и честную
# пометку о том, что остальные не обработаны.
SCAN_MAX_PAGES=50
# Языки локального распознавания (SCAN_MODE=ocr), коды BCP-47 через запятую.
# В учебнике обычно соседствуют изучаемый язык и язык пояснений, поэтому языков
# несколько. Локальный распознаватель — macOS Vision (нужен swiftc из Xcode
# Command Line Tools) либо tesseract из PATH (`brew install tesseract tesseract-lang`).
SCAN_OCR_LANGS=en-US,ru-RU
# Модель для SCAN_MODE=vision: обязана принимать изображения.
# По умолчанию — `ollama pull qwen3-vl:8b-instruct` (~6 ГБ, вход «text, image»).
# Берите вариант -instruct, а не -thinking: рассуждения перед ответом на каждой
# странице — это лишние токены и лишние секунды.
SCAN_VISION_MODEL=qwen3-vl:8b-instruct
# Каталог вспомогательных скриптов распознавания (`macos-ocr.swift`).
# Пусто — искать рядом с кодом сервера, и это верно для запуска из исходников.
# Задаёт его десктопная сборка: там скрипт лежит рядом с приложением, потому что
# компилятору нужен обычный файл, а не файл внутри архива приложения.
OCR_SCRIPTS_DIR=

# ---------- HTTP ----------
# Разрешённые источники CORS через запятую.
# Пусто — только собственный веб (http://localhost:WEB_PORT и 127.0.0.1:WEB_PORT).
# Отражать любой Origin нельзя: без аутентификации это дало бы любому открытому
# в браузере сайту читать ваш профиль, материалы и расшифровки уроков.
CORS_ORIGIN=
# Каталог собранного интерфейса (`web/dist`), который сервер раздаёт сам.
# Пусто — интерфейс поднимает Vite (`npm run dev`), и это обычный режим разработки.
# Заполнено — фронт и API живут на одном источнике и одном порту: так устроена
# десктопная сборка (см. docs/desktop.md), где Vite нет вовсе.
WEB_DIST_DIR=

# ---------- LLM (OpenAI-совместимый HTTP API) ----------
# Куда уходит `POST {LLM_BASE_URL}/chat/completions`.
# По умолчанию — локальная Ollama: `ollama serve` + `ollama pull qwen3:8b`
LLM_BASE_URL=http://localhost:11434/v1
# Нужна модель от 8B с надёжным структурированным JSON-выводом (допущение A15):
# на моделях меньше план урока и проверка ответов заметно хуже
LLM_MODEL=qwen3:8b
# ВАЖНО для Ollama: окно контекста по умолчанию — 4096 токенов, а промпт урока
# (инструкция тьютора, план, профиль, история занятий, цитаты материалов и
# последние реплики) в него не помещается, и llama.cpp молча срезает НАЧАЛО
# промпта — то есть правила тьютора. Поднимите окно у сервера модели:
# переменной окружения `OLLAMA_CONTEXT_LENGTH=8192` (в docker-compose.yml профиля
# ollama она уже задана) или параметром `num_ctx` в Modelfile.
# Ключ API; для локальной Ollama не нужен
LLM_API_KEY=
# Таймаут запроса к модели, мс (1000..600000)
LLM_TIMEOUT_MS=120000
# Температура генерации, 0..2: меньше — стабильнее разбор ответа
LLM_TEMPERATURE=0.3

# ---------- STT: распознавание речи ----------
# browser — распознаёт браузер, серверный `/api/voice/stt` отключён (допущение A3);
# из коробки это работает в Chromium-браузерах, в Firefox — нет;
# openai — OpenAI-совместимый сервер: `POST {STT_BASE_URL}/audio/transcriptions`
# (например, профиль `stt` из docker-compose.yml)
STT_PROVIDER=browser
# Нужны при STT_PROVIDER=openai
STT_BASE_URL=
STT_MODEL=
STT_API_KEY=
# Распознаватель принимает только WAV 16 кГц моно, сжатый звук не распаковывает.
# Так устроен встроенный в десктопную сборку whisper.cpp: он декодирует звук
# библиотекой miniaudio (WAV, MP3, FLAC), а браузер пишет Opus. true — браузер
# перекодирует запись перед отправкой; сервер запись не трогает никогда.
# Для облачного OpenAI и faster-whisper-server оставьте false: Opus в ~10 раз
# компактнее, а распаковать его они умеют сами.
STT_REQUIRE_WAV16=false

# ---------- TTS: синтез речи ----------
# browser — синтезирует браузер, серверный `/api/voice/tts` отключён (допущение A3);
# openai — OpenAI-совместимый сервер: `POST {TTS_BASE_URL}/audio/speech`
# (например, профиль `tts` из docker-compose.yml)
TTS_PROVIDER=browser
# Нужны при TTS_PROVIDER=openai
TTS_BASE_URL=
TTS_MODEL=
# Ключ нужен только облачному провайдеру; локальным Kokoro/Piper — нет
TTS_API_KEY=
TTS_VOICE=
# Формат синтезированного аудио: mp3 | wav | ogg | webm
TTS_FORMAT=mp3
