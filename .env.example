# Скопируйте в `.env` и заполните значения: `cp .env.example .env`

# ---------- Приложение ----------
NODE_ENV=development
# Порт HTTP API (Fastify)
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# Порт dev-сервера Vite
WEB_PORT=5173

# ---------- LLM (OpenAI-совместимый HTTP API) ----------
# Заполняется в wp4
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------- STT: распознавание речи (OpenAI-совместимый HTTP API) ----------
# Заполняется в wp6
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# ---------- TTS: синтез речи (OpenAI-совместимый HTTP API) ----------
# Заполняется в wp20
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
